POSTGRES_USER=taxonomy
POSTGRES_PASSWORD=taxonomy
POSTGRES_DB=taxonomy
DATABASE_URL=postgresql+psycopg://taxonomy:taxonomy@postgres:5432/taxonomy
# host-side API when not using Compose DNS:
# DATABASE_URL=postgresql+psycopg://taxonomy:taxonomy@localhost:5432/taxonomy
DEMO_USER=admin
DEMO_PASSWORD=password

# ---------------------------------------------------------------------------
# OAuth2 / OIDC (default on). Compose also supplies these defaults if unset.
# Clear OIDC_ISSUER + VITE_OIDC_AUTHORITY to fall back to Basic Auth only.
# Local Keycloak: http://localhost:8080 (admin/admin). Realm user: sso.user/password.
# Google/GitHub buttons need OAuth app credentials in Keycloak — see README.
# ---------------------------------------------------------------------------
# Backend (API): browser-facing issuer + in-network JWKS URL for Docker.
OIDC_ISSUER=http://localhost:8080/realms/retail
OIDC_AUDIENCE=retail-taxonomy-api
OIDC_JWKS_URL=http://keycloak:8080/realms/retail/protocol/openid-connect/certs
# OIDC_REQUIRED_SCOPE=            # e.g. taxonomy.write to gate writes by scope

# Frontend (SPA): shows Keycloak / Google / GitHub login options when set.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/retail
VITE_OIDC_CLIENT_ID=retail-taxonomy-spa
VITE_OIDC_SCOPE=openid profile email taxonomy.read taxonomy.write
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
